# Server Configuration
PORT=5000
NODE_ENV=development

# Cookie Security (set to 'true' in production behind HTTPS)
COOKIE_SECURE=false

# Session Encryption Key: 32 bytes (64 hex characters) for AES-256-GCM
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SAP Gateway Configuration
# Set to 'true' to use the local mock OData layer
USE_MOCK_SAP=true
# Real SAP OData Service Base URL (e.g. S/4HANA Business Partner API)
SAP_BASE_URL=https://my-sap-host.example.com/sap/opu/odata/sap/API_BUSINESS_PARTNER

# Allowed Frontend Origins for CORS
FRONTEND_URL=http://localhost:5173

# OpenRouter Conversational AI Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# SAP RFC / BAPI Configuration (NetWeaver / classic RFC)
SAP_RFC_ASHOST=192.168.12.241
SAP_RFC_SYSNR=09
SAP_RFC_CLIENT=500
SAP_RFC_USER=LEELAM_EXT
SAP_RFC_PASSWORD=your_sap_password
SAP_RFC_ROUTER=/H/103.206.249.51/H/
SAP_RFC_GWSERV=3309
SAP_RFC_LANG=EN
SAP_BOM_MODE=RFC
